APP_ENV=development
DATA_FILE=../data/bns_sections.csv
PROCESSED_DATA_FILE=../data/bns_processed.csv
ARTIFACTS_DIR=../artifacts
FAISS_INDEX_FILE=../artifacts/faiss_indexes/bns_sections.index
